---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { getCollection, getEntry } from 'astro:content';
import { piezas, porSala } from '../lib/piezas';
import { SALAS, INFO } from '../lib/salas';
import { url } from '../lib/url';

// Spec 0012 y 0013: la escena se alimenta del contenido.
const perfil = (await getEntry('perfil', 'edrei'))!.data;
const todas = await piezas();
const conteo = await porSala();
const linkedin = perfil.contacto.find((c) => c.etiqueta === 'LinkedIn') ?? perfil.contacto[0]!;
const articulos = (await getCollection('articulos')).map((a) => a.data).sort((a, b) => b.fecha.localeCompare(a.fecha));
const datos = {
  base: import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`,
  salas: SALAS.map((s) => ({ id: s, nombre: INFO[s].nombre, tema: INFO[s].tema, piezas: conteo[s].length })),
  curiosidades: (await getCollection('curiosidades')).map((c) => ({ id: c.id, ...c.data })),
  piezas: todas
    .filter((p) => p.data.objeto)
    .map((p) => ({
      id: p.id,
      catalogo: p.data.catalogo,
      titulo: p.data.titulo,
      subtitulo: p.data.subtitulo,
      resumen: p.data.resumen,
      sala: p.data.sala,
      fecha: p.data.fecha,
      procedencia: p.data.procedencia,
      objeto: p.data.objeto,
      url: url(`piezas/${p.id}`),
      evidencia: p.data.evidencia.filter((e) => e.url).map((e) => ({ etiqueta: e.etiqueta, url: e.url! })),
    })),
};
const titulo = 'El gabinete en 3D · Edrei Robles';
const descripcion = `Recorre el estudio de explorador de ${perfil.nombre}, ${perfil.titulo.toLowerCase()}: proyectos, formación y reconocimientos como piezas de un gabinete de curiosidades.`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0d0907" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
  </head>
  <body class="g-cuerpo">
    <div class="g" data-gabinete data-estado="cargando">
      <canvas
        class="g-lienzo"
        data-lienzo
        role="img"
        aria-label="El estudio de un explorador del siglo XIX: alacena con vitrina, pared de diplomas, baúl, cajonera de boticario, busto de mármol y mesa con globo terráqueo, iluminados por lámparas de aceite."
      ></canvas>
      <div class="g-vineta" aria-hidden="true"></div>
      <!-- FR-0013-04: marcas doradas sobre los objetos a la vista (botones, se enfocan con Tab) -->
      <div class="g-marcas" data-marcas aria-label="Objetos a la vista"></div>
      <div class="g-etiqueta" data-etiqueta hidden aria-hidden="true"></div>

      <!-- FR-0012-06 y FR-0013-05: placa que se pliega al explorar -->
      <header class="g-placa" data-modo="abierta">
        <div class="g-placa__fila">
          <div>
            <p class="g-kicker">{perfil.titulo}</p>
            <h1>{perfil.nombre}</h1>
          </div>
          <button type="button" class="g-placa__toggle" data-placa-toggle aria-expanded="true" aria-controls="g-placa-mas" aria-label="Presentación">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
        </div>
        <div class="g-placa__mas" id="g-placa-mas">
          <p class="g-promesa">{perfil.promesa}</p>
          <p class="g-pruebas">{perfil.pruebas.map((p) => p.texto).join(' · ')}</p>
        </div>
        <div class="g-acciones">
          <a class="g-boton g-boton--principal" href={url('cv')}>Ficha rápida</a>
          <a class="g-boton g-boton--texto" href={linkedin.url} rel="me">Contactar</a>
        </div>
      </header>

      <!-- FR-0013-06: guía de primera visita -->
      <div class="g-guia" data-guia hidden>
        <svg class="g-guia__mano" viewBox="0 0 64 64" width="44" height="44" aria-hidden="true">
          <path d="M26 30V14a4 4 0 0 1 8 0v14l2-1a4 4 0 0 1 5 2l1 2 2-1a4 4 0 0 1 5 2v12c0 9-6 15-14 15h-3c-6 0-10-3-13-8l-6-10a4 4 0 0 1 6-5l7 6z" fill="#f2ece1" stroke="#15100b" stroke-width="2.4" stroke-linejoin="round"></path>
        </svg>
        <p>Arrastra para mirar<br />Toca los <span class="g-guia__punto" aria-hidden="true"></span> dorados</p>
      </div>

      <!-- Nota que dice cada objeto -->
      <div class="g-nota" data-nota hidden role="status">
        <strong data-n-nombre></strong>
        <span data-n-texto></span>
      </div>

      <aside class="g-panel g-cedula" data-cedula hidden aria-labelledby="c-titulo">
        <button type="button" class="g-cerrar" data-cerrar aria-label="Cerrar la cédula">×</button>
        <p class="g-cat" data-c-catalogo></p>
        <h2 id="c-titulo" tabindex="-1" data-c-titulo></h2>
        <p class="g-sub" data-c-subtitulo></p>
        <p class="g-resumen" data-c-resumen></p>
        <div class="g-acciones" data-c-acciones></div>
      </aside>

      <!-- FR-0013-10: biblioteca de divulgación -->
      <aside class="g-panel g-biblioteca" data-biblioteca hidden aria-labelledby="b-titulo">
        <button type="button" class="g-cerrar" data-cerrar aria-label="Cerrar la biblioteca">×</button>
        <p class="g-cat">Biblioteca de divulgación</p>
        <h2 id="b-titulo" tabindex="-1">{articulos.length} artículos sobre IA y aprendizaje</h2>
        <ol class="g-lista">
          {
            articulos.map((a) => (
              <li>
                <a href={a.url} target="_blank" rel="noopener">
                  {a.titulo}
                </a>
                <span>{a.fecha.slice(0, 4)}</span>
              </li>
            ))
          }
        </ol>
      </aside>

      <!-- FR-0013-05: el índice completo vive detrás de "Mapa" -->
      <div class="g-panel g-mapa" id="g-mapa" data-mapa hidden>
        <p class="g-mapa__titulo">Mapa del gabinete</p>
        <ul>
          <li><button type="button" data-estacion="centro">Centro del estudio</button></li>
          {
            datos.salas.map((s) => (
              <li>
                <button type="button" data-estacion={s.id}>
                  {s.nombre} <small>{s.piezas ? s.tema : 'En montaje'}</small>
                </button>
                {datos.piezas.some((p) => p.sala === s.id) && (
                  <ul class="g-mapa__piezas">
                    {datos.piezas
                      .filter((p) => p.sala === s.id)
                      .map((p) => (
                        <li>
                          <button type="button" data-pieza={p.id}>
                            {p.titulo}
                          </button>
                        </li>
                      ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <p class="g-mapa__pie">
          <a href={url()}>Versión clásica</a> · Modelos: <a href="https://polyhaven.com">Poly Haven</a> (CC0)
        </p>
      </div>

      <nav class="g-dock" aria-label="Recorrido del gabinete">
        <button type="button" class="g-dock__mapa" data-abrir-mapa aria-expanded="false" aria-controls="g-mapa">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
          <span>Mapa</span>
        </button>
        <button type="button" class="g-dock__flecha" data-anterior aria-label="Estación anterior">‹</button>
        <span class="g-dock__actual" data-estacion-actual aria-live="polite">Centro del estudio</span>
        <button type="button" class="g-dock__flecha" data-siguiente aria-label="Estación siguiente">›</button>
        <button type="button" class="g-dock__volver" data-volver hidden>Volver</button>
      </nav>

      <div class="g-carga" role="status" aria-live="polite">
        <span class="g-carga__texto">Abriendo el gabinete</span>
        <span class="g-carga__num" data-progreso>0 %</span>
      </div>
      <p class="g-lento">La escena tarda en abrir. <a href={url()}>Ver la versión clásica</a></p>

      <div class="g-respaldo">
        <h2>Este navegador no puede abrir el gabinete en 3D</h2>
        <p>Todo el contenido está en la versión clásica, con las mismas piezas y cédulas.</p>
        <a class="g-boton g-boton--principal" href={url()}>Entrar a la versión clásica</a>
      </div>
      <noscript>
        <div class="g-respaldo g-respaldo--visible">
          <h2>El gabinete en 3D necesita JavaScript</h2>
          <a class="g-boton g-boton--principal" href={url()}>Entrar a la versión clásica</a>
        </div>
      </noscript>
    </div>

    <script id="datos-gabinete" type="application/json" set:html={JSON.stringify(datos)} />
    <script>
      import { iniciar } from '../gabinete/main';
      iniciar().catch((e) => {
        console.error(e);
        document.querySelector<HTMLElement>('[data-gabinete]')!.dataset.estado = 'respaldo';
      });
    </script>
  </body>
</html>

<style is:global>
  .g-cuerpo {
    margin: 0;
    background: #0d0907;
    color: #efe8dc;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .g {
    position: fixed;
    inset: 0;
    font-family: var(--f-texto);
    --g-panel: rgb(16 11 8 / 0.8);
    --g-borde: rgb(201 163 106 / 0.38);
    --g-tinta: #efe8dc;
    --g-suave: #c4b6a0;
    --g-laton: #d6b06a;
  }

  .g-lienzo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .g-lienzo:active {
    cursor: grabbing;
  }

  .g-vineta {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 100% at 50% 45%, transparent 55%, rgb(0 0 0 / 0.55) 100%);
  }

  /* ── Marcas doradas ── */
  .g-marcas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .g-marca {
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 32px;
    margin: -16px 0 0 -16px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    border-radius: 50%;
  }

  .g-marca__punto {
    display: block;
    width: 12px;
    height: 12px;
    margin: 10px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff0c8, #c8923a);
    box-shadow:
      0 0 0 3px rgb(214 176 106 / 0.25),
      0 0 12px rgb(255 196 110 / 0.55);
    animation: g-latido 2.6s ease-in-out infinite;
  }

  .g-marca--pieza .g-marca__punto {
    width: 14px;
    height: 14px;
    margin: 9px;
    box-shadow:
      0 0 0 4px rgb(214 176 106 / 0.32),
      0 0 18px rgb(255 205 130 / 0.85);
  }

  .g-marca__nombre {
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translate(-50%, -2px);
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--g-panel);
    border: 1px solid var(--g-borde);
    font: 600 0.78rem/1.2 var(--f-texto);
    color: var(--g-tinta);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .g-marca:hover .g-marca__nombre,
  .g-marca:focus-visible .g-marca__nombre {
    opacity: 1;
  }

  .g-marca:focus-visible {
    outline: 2px solid var(--g-laton);
    outline-offset: 2px;
  }

  @keyframes g-latido {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.3);
      opacity: 1;
    }
  }

  .g-etiqueta {
    position: absolute;
    left: 0;
    top: 0;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--g-panel);
    border: 1px solid var(--g-borde);
    font: 600 0.82rem/1.2 var(--f-texto);
    color: var(--g-tinta);
    pointer-events: none;
    white-space: nowrap;
  }

  /* ── Paneles ── */
  .g-placa,
  .g-panel,
  .g-dock,
  .g-nota,
  .g-respaldo {
    position: absolute;
    background: var(--g-panel);
    border: 1px solid var(--g-borde);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.9);
  }

  .g-placa {
    top: max(14px, env(safe-area-inset-top));
    left: 14px;
    max-width: min(400px, calc(100vw - 28px));
    padding: 14px 16px;
  }

  .g-placa__fila {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .g-kicker {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--g-laton);
  }

  .g-placa h1 {
    font-family: var(--f-display);
    font-size: clamp(1.8rem, 3.6vw, 2.4rem);
    margin: 2px 0 0;
    color: var(--g-tinta);
    line-height: 1.05;
  }

  .g-placa__toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--g-borde);
    background: transparent;
    color: var(--g-tinta);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .g-placa__mas {
    margin-top: 8px;
  }

  .g-promesa {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.45;
    color: var(--g-suave);
  }

  .g-pruebas {
    margin: 6px 0 0;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--g-laton);
  }

  .g-placa[data-modo='compacta'] {
    padding: 10px 12px;
  }

  .g-placa[data-modo='compacta'] .g-placa__mas {
    display: none;
  }

  .g-placa[data-modo='compacta'] h1 {
    font-size: 1.35rem;
  }

  .g-placa[data-modo='compacta'] .g-kicker {
    font-size: 0.62rem;
  }

  .g-placa[data-modo='compacta'] .g-placa__toggle {
    transform: rotate(180deg);
  }

  .g-placa[data-modo='compacta'] .g-acciones {
    margin-top: 8px;
  }

  .g-placa[data-modo='compacta'] .g-boton {
    min-height: 34px;
    font-size: 0.82rem;
  }

  .g-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .g-boton {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.45em 1em;
    border-radius: 999px;
    border: 1.5px solid var(--g-laton);
    color: var(--g-tinta);
    font: 600 0.9rem/1.2 var(--f-texto);
    text-decoration: none;
    background: transparent;
  }

  .g-boton--principal {
    background: var(--g-laton);
    color: #15100b;
  }

  .g-boton--texto {
    border-color: transparent;
    text-decoration: underline;
  }

  /* ── Guía de primera visita ── */
  .g-guia {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-radius: 16px;
    background: rgb(16 11 8 / 0.72);
    border: 1px solid var(--g-borde);
    text-align: center;
    pointer-events: none;
  }

  .g-guia p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--g-tinta);
  }

  .g-guia__mano {
    animation: g-arrastre 1.8s ease-in-out infinite;
  }

  .g-guia__punto {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    vertical-align: -1px;
    background: radial-gradient(circle at 35% 35%, #fff0c8, #c8923a);
    box-shadow: 0 0 10px rgb(255 196 110 / 0.7);
  }

  @keyframes g-arrastre {
    0%,
    100% {
      transform: translateX(-18px);
    }
    50% {
      transform: translateX(18px);
    }
  }

  /* ── Nota de un objeto ── */
  .g-nota {
    left: 50%;
    bottom: 84px;
    transform: translateX(-50%);
    width: max-content;
    max-width: min(460px, calc(100vw - 28px));
    padding: 10px 16px;
    display: grid;
    gap: 2px;
    text-align: center;
  }

  .g-nota strong {
    font-family: var(--f-display);
    font-size: 1.05rem;
    color: var(--g-laton);
  }

  .g-nota span {
    font-size: 0.9rem;
    color: var(--g-tinta);
  }

  /* ── Cédula y biblioteca ── */
  .g-cedula,
  .g-biblioteca {
    right: 14px;
    bottom: 84px;
    width: min(380px, calc(100vw - 28px));
    max-height: calc(100vh - 120px);
    overflow: auto;
    padding: 18px 20px;
    background: #f2ece1;
    color: #1a1612;
    border-color: #c9a36a;
  }

  .g-panel h2 {
    font-family: var(--f-display);
    font-size: 1.4rem;
    margin: 2px 0 6px;
    line-height: 1.15;
  }

  .g-panel h2:focus {
    outline: none;
  }

  .g-cedula p {
    margin: 0 0 8px;
    font-size: 0.93rem;
    line-height: 1.5;
  }

  .g-cat {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 0.72rem !important;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8e2b22;
  }

  .g-sub {
    color: #574b3f;
  }

  .g-cedula .g-boton {
    color: #1a1612;
    border-color: #1a1612;
  }

  .g-cedula .g-boton--principal {
    background: #1a1612;
    color: #f2ece1;
  }

  .g-lista {
    margin: 10px 0 0;
    padding-left: 1.3em;
    display: grid;
    gap: 8px;
    font-size: 0.9rem;
  }

  .g-lista li::marker {
    color: #8e2b22;
  }

  .g-lista a {
    color: #1a1612;
  }

  .g-lista span {
    margin-left: 6px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    color: #574b3f;
  }

  .g-cerrar {
    position: absolute;
    top: 8px;
    right: 10px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    font-size: 1.6rem;
    line-height: 1;
    color: #1a1612;
    cursor: pointer;
  }

  /* ── Mapa ── */
  .g-mapa {
    left: 50%;
    bottom: 84px;
    transform: translateX(-50%);
    width: min(320px, calc(100vw - 28px));
    max-height: min(70vh, 560px);
    overflow: auto;
    padding: 12px;
  }

  .g-mapa__titulo {
    margin: 2px 6px 8px;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--g-laton);
  }

  .g-mapa ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .g-mapa button {
    width: 100%;
    text-align: left;
    padding: 7px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--g-tinta);
    font: 600 0.95rem/1.25 var(--f-display);
    cursor: pointer;
  }

  .g-mapa button small {
    display: block;
    font: 400 0.74rem/1.3 var(--f-texto);
    color: var(--g-suave);
  }

  .g-mapa button:hover,
  .g-mapa button[aria-current='true'] {
    background: rgb(214 176 106 / 0.16);
  }

  .g-mapa__piezas button {
    padding: 4px 10px 4px 22px;
    font: 400 0.84rem/1.3 var(--f-texto);
    color: var(--g-suave);
  }

  .g-mapa__pie {
    margin: 8px 6px 2px;
