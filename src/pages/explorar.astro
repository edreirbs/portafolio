---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { getEntry } from 'astro:content';
import { piezas, porSala } from '../lib/piezas';
import { SALAS, INFO } from '../lib/salas';
import { url } from '../lib/url';

// Spec 0012: la escena se alimenta del contenido (FR-0012-08).
const perfil = (await getEntry('perfil', 'edrei'))!.data;
const todas = await piezas();
const conteo = await porSala();
const linkedin = perfil.contacto.find((c) => c.etiqueta === 'LinkedIn') ?? perfil.contacto[0]!;
const datos = {
  base: import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`,
  salas: SALAS.map((s) => ({ id: s, nombre: INFO[s].nombre, tema: INFO[s].tema, piezas: conteo[s].length })),
  piezas: todas
    .filter((p) => p.data.objeto)
    .map((p) => ({
      id: p.id,
      catalogo: p.data.catalogo,
      titulo: p.data.titulo,
      subtitulo: p.data.subtitulo,
      resumen: p.data.resumen,
      sala: p.data.sala,
      fecha: p.data.fecha,
      procedencia: p.data.procedencia,
      objeto: p.data.objeto,
      url: url(`piezas/${p.id}`),
      evidencia: p.data.evidencia.filter((e) => e.url).map((e) => ({ etiqueta: e.etiqueta, url: e.url! })),
    })),
};
const titulo = 'El gabinete en 3D · Edrei Robles';
const descripcion = `Recorre el estudio de explorador de ${perfil.nombre}, ${perfil.titulo.toLowerCase()}: proyectos, formación y reconocimientos como piezas de un gabinete de curiosidades.`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0d0907" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
  </head>
  <body class="g-cuerpo">
    <div class="g" data-gabinete data-estado="cargando">
      <canvas
        class="g-lienzo"
        data-lienzo
        role="img"
        aria-label="El estudio de un explorador del siglo XIX: alacena con vitrina, pared de diplomas, baúl, cajonera de boticario, busto de mármol y mesa con globo terráqueo, iluminados por lámparas de aceite."
      ></canvas>
      <div class="g-vineta" aria-hidden="true"></div>

      <header class="g-placa">
        <p class="g-kicker">{perfil.titulo}</p>
        <h1>{perfil.nombre}</h1>
        <p class="g-promesa">{perfil.promesa}</p>
        <p class="g-pruebas">{perfil.pruebas.map((p) => p.texto).join(' · ')}</p>
        <div class="g-acciones">
          <a class="g-boton g-boton--principal" href={url('cv')}>Ficha rápida</a>
          <a class="g-boton" href={url()}>Versión clásica</a>
          <a class="g-boton g-boton--texto" href={linkedin.url} rel="me">Contactar</a>
        </div>
      </header>

      <nav class="g-indice" aria-label="Estaciones del gabinete">
        <p class="g-indice__titulo">Estaciones</p>
        <ul>
          <li><button type="button" data-estacion="centro">Centro del estudio</button></li>
          {
            datos.salas.map((s) => (
              <li>
                <button type="button" data-estacion={s.id}>
                  {s.nombre} <small>{s.piezas ? `${s.tema}` : 'En montaje'}</small>
                </button>
                {datos.piezas.some((p) => p.sala === s.id) && (
                  <ul class="g-indice__piezas">
                    {datos.piezas
                      .filter((p) => p.sala === s.id)
                      .map((p) => (
                        <li>
                          <button type="button" data-pieza={p.id}>
                            {p.titulo}
                          </button>
                        </li>
                      ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <aside class="g-cedula" data-cedula hidden aria-labelledby="c-titulo">
        <button type="button" class="g-cerrar" data-cerrar aria-label="Cerrar la cédula">×</button>
        <p class="g-cat" data-c-catalogo></p>
        <h2 id="c-titulo" tabindex="-1" data-c-titulo></h2>
        <p class="g-sub" data-c-subtitulo></p>
        <p data-c-resumen></p>
        <p class="g-proc" data-c-procedencia></p>
        <div class="g-acciones" data-c-acciones></div>
      </aside>

      <div class="g-carga" role="status" aria-live="polite">
        <span class="g-carga__texto">Abriendo el gabinete</span>
        <span class="g-carga__num" data-progreso>0 %</span>
      </div>
      <p class="g-lento">La escena tarda en abrir. <a href={url()}>Ver la versión clásica</a></p>
      <p class="g-pista" aria-hidden="true">Arrastra para mirar · Elige un mueble o una pieza</p>
      <p class="g-creditos">Modelos y texturas: <a href="https://polyhaven.com">Poly Haven</a> (CC0)</p>

      <div class="g-respaldo">
        <h2>Este navegador no puede abrir el gabinete en 3D</h2>
        <p>Todo el contenido está en la versión clásica, con las mismas piezas y cédulas.</p>
        <a class="g-boton g-boton--principal" href={url()}>Entrar a la versión clásica</a>
      </div>
      <noscript>
        <div class="g-respaldo g-respaldo--visible">
          <h2>El gabinete en 3D necesita JavaScript</h2>
          <a class="g-boton g-boton--principal" href={url()}>Entrar a la versión clásica</a>
        </div>
      </noscript>
    </div>

    <script id="datos-gabinete" type="application/json" set:html={JSON.stringify(datos)} />
    <script>
      import { iniciar } from '../gabinete/main';
      iniciar().catch((e) => {
        console.error(e);
        document.querySelector<HTMLElement>('[data-gabinete]')!.dataset.estado = 'respaldo';
      });
    </script>
  </body>
</html>

<style is:global>
  .g-cuerpo {
    margin: 0;
    background: #0d0907;
    color: #efe8dc;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .g {
    position: fixed;
    inset: 0;
    font-family: var(--f-texto);
    --g-panel: rgb(16 11 8 / 0.78);
    --g-borde: rgb(201 163 106 / 0.38);
    --g-tinta: #efe8dc;
    --g-suave: #c4b6a0;
    --g-laton: #d6b06a;
  }

  .g-lienzo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .g-lienzo:active {
    cursor: grabbing;
  }

  .g-vineta {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 100% at 50% 45%, transparent 55%, rgb(0 0 0 / 0.55) 100%);
  }

  .g-placa,
  .g-indice,
  .g-cedula,
  .g-respaldo {
    position: absolute;
    background: var(--g-panel);
    border: 1px solid var(--g-borde);
    border-radius: 12px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.9);
  }

  .g-placa {
    top: max(16px, env(safe-area-inset-top));
    left: 16px;
    max-width: min(420px, calc(100vw - 32px));
    padding: 16px 18px;
  }

  .g-kicker {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--g-laton);
  }

  .g-placa h1 {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 144;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 4px 0 6px;
    color: var(--g-tinta);
  }

  .g-promesa {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--g-suave);
  }

  .g-pruebas {
    margin: 8px 0 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--g-laton);
  }

  .g-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .g-boton {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.45em 1em;
    border-radius: 999px;
    border: 1.5px solid var(--g-laton);
    color: var(--g-tinta);
    font: 600 0.9rem/1.2 var(--f-texto);
    text-decoration: none;
    background: transparent;
  }

  .g-boton--principal {
    background: var(--g-laton);
    color: #15100b;
  }

  .g-boton--texto {
    border-color: transparent;
    text-decoration: underline;
  }

  .g-indice {
    top: max(16px, env(safe-area-inset-top));
    right: 16px;
    width: 250px;
    max-height: calc(100vh - 120px);
    overflow: auto;
    padding: 12px;
  }

  .g-indice__titulo {
    margin: 2px 6px 8px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--g-laton);
  }

  .g-indice ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .g-indice button {
    width: 100%;
    text-align: left;
    padding: 8px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--g-tinta);
    font: 600 0.95rem/1.25 var(--f-display);
    cursor: pointer;
  }

  .g-indice button small {
    display: block;
    font: 400 0.75rem/1.3 var(--f-texto);
    color: var(--g-suave);
  }

  .g-indice button:hover,
  .g-indice button[aria-current='true'] {
    background: rgb(214 176 106 / 0.16);
  }

  .g-indice__piezas button {
    padding: 5px 10px 5px 22px;
    font: 400 0.84rem/1.3 var(--f-texto);
    color: var(--g-suave);
  }

  .g-cedula {
    right: 16px;
    bottom: 56px;
    width: min(380px, calc(100vw - 32px));
    padding: 20px 20px 18px;
    background: #f2ece1;
    color: #1a1612;
    border-color: #c9a36a;
  }

  .g-cedula h2 {
    font-family: var(--f-display);
    font-size: 1.45rem;
    margin: 4px 0 6px;
  }

  .g-cedula h2:focus {
    outline: none;
  }

  .g-cedula p {
    margin: 0 0 8px;
    font-size: 0.93rem;
    line-height: 1.5;
  }

  .g-cat {
    font-family: var(--f-mono);
    font-size: 0.75rem !important;
    letter-spacing: 0.1em;
    color: #8e2b22;
  }

  .g-sub,
  .g-proc {
    color: #574b3f;
  }

  .g-cedula .g-boton {
    color: #1a1612;
    border-color: #1a1612;
  }

  .g-cedula .g-boton--principal {
    background: #1a1612;
    color: #f2ece1;
  }

  .g-cerrar {
    position: absolute;
    top: 8px;
    right: 10px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    font-size: 1.6rem;
    line-height: 1;
    color: #1a1612;
    cursor: pointer;
  }

  .g-carga {
    position: absolute;
    left: 50%;
    bottom: 40%;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 6px;
    color: var(--g-suave);
    font-family: var(--f-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: opacity 0.6s ease;
  }

  .g-carga__num {
    font-family: var(--f-display);
    font-size: 2.4rem;
    letter-spacing: 0;
    color: var(--g-laton);
  }

  .g-pista,
  .g-creditos,
  .g-lento {
    position: absolute;
    margin: 0;
    font-size: 0.8rem;
    color: var(--g-suave);
  }

  .g-pista {
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--g-panel);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .g-creditos {
    left: 16px;
    bottom: 12px;
    font-size: 0.72rem;
  }

  .g-creditos a,
  .g-lento a {
    color: inherit;
  }

  .g-lento {
    display: none;
    left: 50%;
    bottom: 30%;
    transform: translateX(-50%);
  }

  .g[data-lento]:not([data-estado='listo']) .g-lento {
    display: block;
  }

  .g-respaldo {
    display: none;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(460px, calc(100vw - 32px));
    padding: 24px;
    text-align: center;
  }

  .g-respaldo h2 {
    font-family: var(--f-display);
    font-size: 1.5rem;
    margin: 0 0 8px;
  }

  .g-respaldo p {
    color: var(--g-suave);
  }

  .g-respaldo--visible {
    display: block;
  }

  .g[data-estado='listo'] .g-carga {
    opacity: 0;
    pointer-events: none;
  }

  .g[data-estado='listo'] .g-pista {
    opacity: 1;
    animation: g-desvanecer 1s ease 7s forwards;
  }

  .g[data-estado='respaldo'] .g-lienzo,
  .g[data-estado='respaldo'] .g-indice,
  .g[data-estado='respaldo'] .g-carga,
  .g[data-estado='respaldo'] .g-pista {
    display: none;
  }

  .g[data-estado='respaldo'] .g-respaldo {
    display: block;
  }

  .g[data-estado='respaldo'] .g-placa {
    position: static;
    margin: 16px auto;
  }

  @keyframes g-desvanecer {
    to {
      opacity: 0;
    }
  }

  /* Teléfono: placa compacta arriba, estaciones como tira abajo */
  @media (max-width: 760px) {
    .g-promesa {
      display: none;
    }

    .g-placa {
      padding: 12px 14px;
      right: 16px;
    }

    .g-placa h1 {
      font-size: 1.7rem;
    }

    .g-indice {
      top: auto;
      right: 0;
      left: 0;
      bottom: 0;
      width: auto;
      max-height: none;
      border-radius: 14px 14px 0 0;
      padding: 8px 8px max(8px, env(safe-area-inset-bottom));
      overflow-x: auto;
    }

    .g-indice__titulo,
    .g-indice__piezas {
      display: none;
    }

    .g-indice > ul {
      display: flex;
      gap: 4px;
    }

    .g-indice button {
      white-space: nowrap;
    }

    .g-cedula {
      left: 12px;
      right: 12px;
      bottom: 86px;
      width: auto;
      max-height: 55vh;
      overflow: auto;
    }

    .g-creditos {
      display: none;
    }

    .g-pista {
      bottom: 90px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .g-carga,
    .g-pista {
      transition: none;
      animation: none !important;
    }
  }
</style>
