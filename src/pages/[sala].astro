---
// FR-0014-09: las salas de la F1 ahora son secciones de la portada.
import type { GetStaticPaths } from 'astro';
import Redireccion from '../components/Redireccion.astro';
import { SALAS, type Sala } from '../lib/salas';
import { url } from '../lib/url';
import { portafolio } from '../lib/portafolio';

const DESTINO: Record<Sala, string> = {
  artificialia: 'proyectos',
  theatrum: 'experiencia',
  scientifica: 'certificaciones',
  naturalia: 'titulos',
  mirabilia: 'titulos',
  exotica: 'proyectos',
};

export const getStaticPaths = (() => SALAS.map((sala) => ({ params: { sala } }))) satisfies GetStaticPaths;
const { sala } = Astro.params as { sala: Sala };
const { visibles } = await portafolio();
const seccion = DESTINO[sala];
const destino = (visibles as string[]).includes(seccion) ? url(`#${seccion}`) : url();
---

<Redireccion destino={destino} />
