---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base titulo="Pieza no encontrada" descripcion="Esta pieza no está en el catálogo.">
  <div class="contenedor vacio">
    <p class="etiqueta">Error 404 · vitrina vacía</p>
    <h1>Esta pieza no está en el catálogo</h1>
    <p>Puede que la hayan movido de sala. Vuelve al vestíbulo y recorre el plano del gabinete.</p>
    <p><a class="boton boton--principal" href={url()}>Volver al vestíbulo</a></p>
  </div>
</Base>
