---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TarjetaPieza from '../../components/TarjetaPieza.astro';
import { piezas, relacionadas, type Pieza } from '../../lib/piezas';
import { INFO_SECCION, seccionDe } from '../../lib/secciones';
import { mes } from '../../lib/fechas';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const todas = await piezas();
  return todas.map((pieza) => ({ params: { slug: pieza.id }, props: { pieza, todas } }));
}) satisfies GetStaticPaths;

const { pieza, todas } = Astro.props as { pieza: Pieza; todas: Pieza[] };
const d = pieza.data;
const { Content } = await render(pieza);
const vecinas = relacionadas(pieza, todas);
const ESTADOS = { activo: 'En desarrollo activo', terminado: 'Terminado', archivado: 'Archivado' } as const;
const cuando = d.fecha_fin
  ? `${mes(d.fecha)} – ${d.fecha_fin === 'en curso' ? 'en curso' : d.fecha_fin === 'vigente' ? 'hoy' : mes(d.fecha_fin)}`
  : mes(d.fecha);
const conLiga = d.evidencia.filter((e) => e.url);
// Spec 0010: al compartir una pieza se ve su imagen, si tiene.
const imagenOg = d.imagen && d.imagen.src.format !== 'svg'
  ? new URL((await getImage({ src: d.imagen.src, width: 1200, format: 'jpg' })).src, Astro.site).href
  : undefined;
const sinLiga = d.evidencia.filter((e) => !e.url);
---

<Base titulo={d.titulo} descripcion={d.resumen} actual={d.sala} imagen={imagenOg} imagenAlt={d.imagen?.alt} tipo="article">
  <div class="contenedor">
    <header class="encabezado">
      <nav class="migas" aria-label="Ruta">
        <a href={url()}>Portafolio</a> / <a href={url(`#${seccionDe(pieza)}`)}>{INFO_SECCION[seccionDe(pieza)].nombre}</a> / {d.catalogo}
      </nav>
      <h1>{d.titulo}</h1>
      <p>{d.subtitulo}</p>
    </header>

    <div class="ficha-pieza">
      <div>
        {
          d.imagen && (
            <figure class="marco-grande">
              <Image
                src={d.imagen.src}
                alt={d.imagen.alt}
                widths={[640, 960, 1400]}
                sizes="(min-width: 1200px) 760px, (min-width: 960px) 62vw, 94vw"
                loading="eager"
              />
            </figure>
          )
        }
        <div class="prosa">
          <p>{d.resumen}</p>
          <Content />
        </div>
      </div>

      <aside class="ficha-pieza__cedula" aria-label="Cédula">
        <div class="cedula-grande">
          <span class="catalogo" style="color: var(--lacre)">{d.catalogo}</span>
          <dl>
            <div><dt>Fecha</dt><dd>{cuando}</dd></div>
            <div><dt>Procedencia</dt><dd>{d.procedencia}</dd></div>
            {d.rol && <div><dt>Rol</dt><dd>{d.rol}</dd></div>}
            {d.estado && <div><dt>Estado</dt><dd>{ESTADOS[d.estado]}</dd></div>}
            {d.tesis && <div><dt>Tesis</dt><dd>{d.tesis}</dd></div>}
            {d.distinciones && <div><dt>Distinciones</dt><dd>{d.distinciones}</dd></div>}
            {d.otorgante && <div><dt>Otorgante</dt><dd>{d.otorgante}</dd></div>}
            {
              d.materiales.length > 0 && (
                <div>
                  <dt>Materiales</dt>
                  <dd>
                    <ul class="materiales">{d.materiales.map((m) => <li>{m}</li>)}</ul>
                  </dd>
                </div>
              )
            }
          </dl>
          {
            d.cifras.length > 0 && (
              <ul class="cifras">
                {d.cifras.map((c) => (
                  <li title={`Fuente: ${c.fuente}`}>
                    <strong>{c.valor}</strong>
                    <span>{c.etiqueta}</span>
                  </li>
                ))}
              </ul>
            )
          }
          <div class="evidencias">
            {
              conLiga.map((e, i) => (
                <a class:list={['boton', i === 0 && 'boton--principal']} href={e.url}>
                  {e.etiqueta}
                </a>
              ))
            }
            {sinLiga.map((e) => <p class="evidencias__nota">Evidencia: {e.etiqueta}.</p>)}
          </div>
        </div>
      </aside>
    </div>

    {
      vecinas.length > 0 && (
        <section class="seccion" aria-labelledby="relacionadas">
          <div class="seccion__cabeza">
            <p class="etiqueta">En la misma vitrina</p>
            <h2 id="relacionadas">Piezas relacionadas</h2>
          </div>
          <ul class="vitrina">
            {vecinas.map((p) => (
              <li>
                <TarjetaPieza pieza={p} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
