---
import { getEntry } from 'astro:content';
import { fechaActualizacion } from '../lib/build';
import { UI, etiquetaRed, fechaLarga, type Idioma } from '../lib/idioma';
const { idioma = 'es' } = Astro.props as { idioma?: Idioma };
const t = UI[idioma];
const fecha = fechaActualizacion();
const perfil = (await getEntry('perfil', 'edrei'))!.data;
---

<footer class="pie">
  <div class="contenedor pie__fila">
    <!-- FR-0014-07: las redes también viven en el pie. -->
    <ul class="pie__redes" aria-label={t.redes}>
      {
        perfil.contacto.map((c) => (
          <li>
            <a href={c.url} rel="me">
              {etiquetaRed(c.etiqueta, idioma)}
            </a>
          </li>
        ))
      }
    </ul>
    <p>{t.actualizado} <time datetime={fecha.toISOString()}>{fechaLarga(fecha, idioma)}</time>.</p>
    <p>
      {t.construido} <i>spec-driven development</i>.{' '}
      <a href="https://github.com/edreirbs/portafolio">{t.verCodigo}</a>
    </p>
  </div>
</footer>
