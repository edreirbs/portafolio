---
import { Image } from 'astro:assets';
import type { Pieza } from '../lib/piezas';
import { seccionDe } from '../lib/secciones';
import { anio, periodoAnios } from '../lib/fechas';
import { infoSeccion, ligasPieza, textoPieza, type Idioma } from '../lib/idioma';
import { url } from '../lib/url';

interface Props {
  pieza: Pieza;
  nivel?: 'h2' | 'h3';
  prioridad?: boolean;
  idioma?: Idioma;
}
const { pieza, nivel = 'h3', prioridad = false, idioma = 'es' } = Astro.props;
const d = pieza.data;
const Titulo = nivel;
const t = textoPieza(pieza, idioma);
const cuando = d.sala === 'naturalia' && d.fecha_fin ? periodoAnios(d.fecha, d.fecha_fin, idioma) : anio(d.fecha);
const ligas = ligasPieza(pieza, idioma);
// Spec 0009: en inglés no hay página de detalle; el título lleva a la evidencia principal.
const destino = idioma === 'es' ? url(`piezas/${pieza.id}`) : ligas[0]?.url;
---

<article class="pieza">
  <div class="pieza__marco">
    {
      d.imagen ? (
        <Image
          src={d.imagen.src}
          alt=""
          widths={[400, 640, 960]}
          sizes="(min-width: 1200px) 380px, (min-width: 700px) 45vw, 92vw"
          loading={prioridad ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="especimen" aria-hidden="true">{d.catalogo.slice(0, 2)}</div>
      )
    }
  </div>
  <div class="pieza__cuerpo">
    <span class="catalogo">{d.catalogo}</span>
    <Titulo>{destino ? <a href={destino} rel={idioma === 'es' ? undefined : 'noopener'}>{t.titulo}</a> : t.titulo}</Titulo>
    <p class="pieza__sub">{t.subtitulo}</p>
    {idioma === 'en' && <p class="pieza__resumen">{t.resumen}</p>}
    {
      ligas.length > 0 && (
        <p class="pieza__ligas">
          {ligas.map((e) => (
            <a href={e.url} rel="noopener">
              {e.etiqueta}
            </a>
          ))}
          {d.objeto && idioma === 'es' && (
            <button type="button" class="ficha__mirar" data-mirar={pieza.id} hidden>
              Mirar en el gabinete
            </button>
          )}
        </p>
      )
    }
    <div class="pieza__pie">
      <span>{infoSeccion(seccionDe(pieza), idioma).corto}</span>
      <span>{cuando}</span>
    </div>
  </div>
</article>
