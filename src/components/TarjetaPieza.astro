---
import { Image } from 'astro:assets';
import type { Pieza } from '../lib/piezas';
import { INFO_SECCION, seccionDe } from '../lib/secciones';
import { anio, periodoAnios } from '../lib/fechas';
import { url } from '../lib/url';

interface Props {
  pieza: Pieza;
  nivel?: 'h2' | 'h3';
  prioridad?: boolean;
}
const { pieza, nivel = 'h3', prioridad = false } = Astro.props;
const d = pieza.data;
const Titulo = nivel;
const cuando = d.sala === 'naturalia' && d.fecha_fin ? periodoAnios(d.fecha, d.fecha_fin) : anio(d.fecha);
const ligas = d.evidencia.filter((e) => e.url).slice(0, 2);
---

<article class="pieza">
  <div class="pieza__marco">
    {
      d.imagen ? (
        <Image
          src={d.imagen.src}
          alt=""
          widths={[400, 640, 960]}
          sizes="(min-width: 1200px) 380px, (min-width: 700px) 45vw, 92vw"
          loading={prioridad ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="especimen" aria-hidden="true">{d.catalogo.slice(0, 2)}</div>
      )
    }
  </div>
  <div class="pieza__cuerpo">
    <span class="catalogo">{d.catalogo}</span>
    <Titulo><a href={url(`piezas/${pieza.id}`)}>{d.titulo}</a></Titulo>
    <p class="pieza__sub">{d.subtitulo}</p>
    {
      ligas.length > 0 && (
        <p class="pieza__ligas">
          {ligas.map((e) => (
            <a href={e.url} rel="noopener">
              {e.etiqueta}
            </a>
          ))}
          {d.objeto && (
            <button type="button" class="ficha__mirar" data-mirar={pieza.id} hidden>
              Mirar en el gabinete
            </button>
          )}
        </p>
      )
    }
    <div class="pieza__pie">
      <span>{INFO_SECCION[seccionDe(pieza)].corto}</span>
      <span>{cuando}</span>
    </div>
  </div>
</article>
