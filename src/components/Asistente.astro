---
// Spec 0015 · El botón y el panel del asistente. El HTML es fijo y ligero; la lógica se descarga
// solo cuando alguien lo abre (FR-0015-08). El botón aparece solo si el servidor está listo.
import { API_ASISTENTE, AVISO, SUGERENCIAS } from '../lib/asistente';
import { portafolio } from '../lib/portafolio';
import { url } from '../lib/url';

const { perfil, todas, articulos } = await portafolio();
const linkedin = perfil.contacto.find((c) => c.etiqueta === 'LinkedIn') ?? perfil.contacto[0]!;
// Las ligas que el asistente puede mostrar: las del portafolio y su evidencia.
const hosts = new Set<string>(['edreirbs.github.io']);
for (const u of [
  ...perfil.contacto.map((c) => c.url),
  ...todas.flatMap((p) => p.data.evidencia.map((e) => e.url).filter((x): x is string => Boolean(x))),
  ...articulos.map((a) => a.url),
]) {
  hosts.add(new URL(u).hostname);
}
const config = {
  api: API_ASISTENTE,
  sugerencias: SUGERENCIAS,
  hosts: [...hosts],
  cv: url('cv'),
  linkedin: linkedin.url,
};
---

<button type="button" class="asis-lanzador" data-asistente-abrir hidden aria-controls="asistente" aria-expanded="false" aria-label="Pregúntale a mi asistente">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path
      d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
    <path d="M8.5 8.5h7M8.5 11.5h4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
  </svg>
  <span>Pregúntale a mi asistente</span>
</button>

<section class="asis" id="asistente" role="dialog" aria-modal="false" aria-labelledby="asis-titulo" hidden>
  <header class="asis__cabeza">
    <span class="asis__sello" aria-hidden="true">ER</span>
    <div class="asis__nombre">
      <h2 id="asis-titulo" tabindex="-1">Asistente de Edrei</h2>
      <p>Pregunta por su trayectoria, proyectos o formación</p>
    </div>
    <button type="button" class="asis__icono" data-asis-nueva aria-label="Empezar una conversación nueva" title="Empezar de nuevo">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
    <button type="button" class="asis__icono" data-asis-cerrar aria-label="Cerrar el asistente" title="Cerrar">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
  </header>
  <div class="asis__registro" data-asis-registro></div>
  <div class="asis__pie">
    <div class="asis__sugerencias" data-asis-sugerencias aria-label="Preguntas sugeridas" role="group"></div>
    <form class="asis__forma" data-asis-forma>
      <label class="visualmente-oculto" for="asis-entrada">Tu pregunta sobre Edrei</label>
      <textarea id="asis-entrada" rows="1" maxlength="500" placeholder="Escribe tu pregunta…" autocomplete="off"></textarea>
      <button type="submit" class="asis__enviar" data-asis-enviar aria-label="Enviar la pregunta">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button type="button" class="asis__enviar asis__detener" data-asis-detener aria-label="Detener la respuesta" hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor"></rect></svg>
      </button>
    </form>
    <p class="asis__aviso"><span data-asis-cuenta></span>{AVISO}</p>
  </div>
  <p class="visualmente-oculto" data-asis-anuncio aria-live="polite"></p>
</section>

<script type="application/json" id="asistente-config" set:html={JSON.stringify(config)} />

<script>
  // FR-0015-10: el botón aparece solo si el servidor tiene llave. Se pregunta después de cargar.
  import { API_ASISTENTE } from '../lib/asistente';

  const boton = document.querySelector<HTMLButtonElement>('[data-asistente-abrir]')!;
  let modulo: Promise<typeof import('../asistente/chat')> | null = null;
  const abrir = (origen?: HTMLElement) => {
    modulo ??= import('../asistente/chat');
    modulo.then((m) => m.abrir(origen ?? boton)).catch(() => (modulo = null));
  };

  const listo = () => {
    document.documentElement.dataset.asistente = 'listo';
    boton.hidden = false;
    window.dispatchEvent(new Event('asistente:listo'));
    // FR-0015-06: si había una conversación abierta en esta visita, se reabre.
    try {
      if (sessionStorage.getItem('asistente-abierto') === '1') abrir();
    } catch {
      /* sin almacenamiento */
    }
  };

  const consultar = async () => {
    try {
      const guardado = sessionStorage.getItem('asistente-listo');
      if (guardado === '1') return listo();
      if (guardado === '0') return;
    } catch {
      /* sin almacenamiento */
    }
    try {
      const r = await fetch(`${API_ASISTENTE}/estado`, { signal: AbortSignal.timeout(6000) });
      const { listo: ok } = (await r.json()) as { listo?: boolean };
      try {
        sessionStorage.setItem('asistente-listo', ok ? '1' : '0');
      } catch {
        /* sin almacenamiento */
      }
      if (ok) listo();
    } catch {
      /* sin servidor: el sitio sigue completo, sin botón */
    }
  };

  boton.addEventListener('click', () => abrir(boton));
  document.querySelectorAll<HTMLElement>('[data-asistente-otro]').forEach((b) => b.addEventListener('click', () => abrir(b)));
  window.addEventListener('asistente:abrir', () => abrir());
  const despues = () => ('requestIdleCallback' in window ? requestIdleCallback(() => consultar(), { timeout: 3000 }) : setTimeout(consultar, 1200));
  if (document.readyState === 'complete') despues();
  else window.addEventListener('load', despues, { once: true });
</script>

<style is:global>
  /* ── Spec 0015 · Botón ── */
  .asis-lanzador {
    position: fixed;
    z-index: 50;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 50px;
    padding: 0 20px 0 16px;
    border: 1.5px solid #c9a36a;
    border-radius: 999px;
    background: #1a1612;
    color: #f2ece1;
    font: 600 0.95rem/1 var(--f-texto);
    box-shadow: 0 14px 34px -14px rgb(0 0 0 / 0.65);
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .asis-lanzador:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -14px rgb(0 0 0 / 0.75);
  }

  .asis-lanzador:focus-visible {
    outline: 3px solid #d6b06a;
    outline-offset: 3px;
  }

  .asis-lanzador[hidden],
  html[data-asistente-abierto] .asis-lanzador {
    display: none;
  }

  html[data-vista='3d'] .asis-lanzador {
    bottom: 22px;
    right: 18px;
  }

  /* En el 3D de ancho medio, el botón se vuelve círculo para no chocar con la barra. */
  @media (max-width: 1040px) {
    html[data-vista='3d'] .asis-lanzador {
      width: 52px;
      height: 52px;
      padding: 0;
      justify-content: center;
    }

    html[data-vista='3d'] .asis-lanzador span {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .asis-lanzador {
      padding: 0 16px 0 14px;
    }

    html[data-vista='3d'] .asis-lanzador {
      bottom: 84px;
      right: 12px;
    }
  }

  @media (max-width: 420px) {
    .asis-lanzador span {
      display: none;
    }

    .asis-lanzador {
      width: 54px;
      height: 54px;
      padding: 0;
      justify-content: center;
    }
  }

  /* ── Spec 0015 · Panel ── */
  .asis {
    --a-papel: #f4eee3;
    --a-tinta: #1a1612;
    --a-suave: #5c4f42;
    --a-linea: rgb(26 22 18 / 0.14);
    --a-acento: #7a5a2b;
    position: fixed;
    z-index: 60;
    right: 16px;
    bottom: 16px;
    top: 16px;
    width: min(440px, calc(100vw - 32px));
    display: flex;
    flex-direction: column;
    background: var(--a-papel);
    color: var(--a-tinta);
    border: 1px solid #c9a36a;
    border-radius: 16px;
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.75);
    overflow: hidden;
    font-family: var(--f-texto);
  }

  .asis[hidden] {
    display: none;
  }

  html[data-vista='3d'] .asis {
    top: 74px;
    bottom: 84px;
    right: 14px;
    width: min(460px, calc(100vw - 28px));
  }

  @media (max-width: 1120px) {
    html[data-vista='3d'] .asis {
      top: max(14px, env(safe-area-inset-top));
    }
  }

  @media (max-width: 760px) {
    .asis,
    html[data-vista='3d'] .asis {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      height: min(88dvh, 720px);
      border-radius: 18px 18px 0 0;
      border-bottom: 0;
    }
  }

  .asis__cabeza {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 10px 12px 16px;
    border-bottom: 1px solid var(--a-linea);
  }

  .asis__sello {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #8e2b22;
    color: #f6e3d6;
    font: 600 0.85rem/1 var(--f-display);
    box-shadow: inset 0 0 0 3px rgb(0 0 0 / 0.14);
  }

  .asis__nombre {
    flex: 1;
    min-width: 0;
  }

  .asis__nombre h2 {
    margin: 0;
    font-family: var(--f-display);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .asis__nombre h2:focus {
    outline: none;
  }

  .asis__nombre p {
    font-size: 0.8rem;
    color: var(--a-suave);
  }

  .asis__icono {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--a-tinta);
    cursor: pointer;
  }

  .asis__icono:hover {
    background: rgb(26 22 18 / 0.07);
  }

  .asis :focus-visible {
    outline: 2px solid var(--a-acento);
    outline-offset: 2px;
  }

  .asis__registro {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px 16px 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-behavior: smooth;
  }

  .asis-msj {
    max-width: 92%;
    font-size: 0.95rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .asis-msj p + p,
  .asis-msj p + ul,
  .asis-msj ul + p {
    margin-top: 8px;
  }

  .asis-msj ul {
    margin: 6px 0 0;
    padding-left: 1.1em;
    display: grid;
    gap: 4px;
  }

  .asis-msj a {
    color: var(--a-acento);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .asis-msj--usuario {
    align-self: flex-end;
    padding: 10px 14px;
    border-radius: 16px 16px 4px 16px;
    background: #1a1612;
    color: #f4eee3;
  }

  .asis-msj--asistente {
    align-self: flex-start;
  }

  .asis-msj--aviso {
    align-self: stretch;
    max-width: none;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgb(142 43 34 / 0.08);
    border: 1px solid rgb(142 43 34 / 0.25);
    font-size: 0.9rem;
  }

  .asis-msj--cortado::after {
    content: ' (respuesta detenida)';
    color: var(--a-suave);
    font-size: 0.85em;
  }

  .asis-pensando {
    display: inline-flex;
    gap: 5px;
    padding: 6px 0;
  }

  .asis-pensando i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--a-acento);
    animation: asis-punto 1.1s ease-in-out infinite;
  }

  .asis-pensando i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .asis-pensando i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes asis-punto {
    0%,
    80%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  .asis__pie {
    padding: 8px 12px max(12px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--a-linea);
    background: var(--a-papel);
  }

  .asis__sugerencias {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 2px 2px 8px;
    scrollbar-width: none;
  }

  .asis__sugerencias:empty {
    display: none;
  }

  .asis__sugerencias button {
    flex: none;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #c9a36a;
    border-radius: 999px;
    background: #fbf8f2;
    color: var(--a-tinta);
    font: 500 0.85rem/1 var(--f-texto);
    cursor: pointer;
    white-space: nowrap;
  }

  .asis__sugerencias button:hover {
    background: #fff;
    border-color: var(--a-acento);
  }

  .asis__forma {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 6px 6px 6px 14px;
    border: 1.5px solid var(--a-linea);
    border-radius: 22px;
    background: #fff;
  }

  .asis__forma:focus-within {
    border-color: var(--a-acento);
  }

  .asis__forma textarea {
    flex: 1;
    min-height: 24px;
    max-height: 120px;
    margin: 0 0 6px;
    padding: 0;
    border: 0;
    resize: none;
    background: transparent;
    color: var(--a-tinta);
    font: 400 16px/1.45 var(--f-texto);
  }

  .asis__forma textarea:focus {
    outline: none;
  }

  .asis__forma textarea::placeholder {
    color: #7a6d60;
  }

  .asis__enviar {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #1a1612;
    color: #f4eee3;
    cursor: pointer;
  }

  .asis__enviar:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .asis__detener {
    background: #8e2b22;
  }

  .asis__aviso {
    margin-top: 6px;
    font-size: 0.74rem;
    line-height: 1.35;
    color: var(--a-suave);
    text-align: center;
  }

  .asis__aviso span:not(:empty)::after {
    content: ' · ';
  }

  @media (prefers-reduced-motion: reduce) {
    .asis-pensando i {
      animation: none;
      opacity: 0.6;
    }

    .asis__registro {
      scroll-behavior: auto;
    }

    .asis-lanzador {
      transition: none;
    }
  }

  @media print {
    .asis,
    .asis-lanzador {
      display: none !important;
    }
  }
</style>
