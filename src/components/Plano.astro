---
import { SALAS, INFO, type Sala } from '../lib/salas';
import type { Pieza } from '../lib/piezas';
import { url } from '../lib/url';

interface Props {
  conteo: Record<Sala, Pieza[]>;
}
const { conteo } = Astro.props;
const romanos = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---

<ul class="plano">
  {
    SALAS.map((sala, i) => {
      const n = conteo[sala].length;
      const abierta = n > 0;
      return (
        <li class:list={['sala', abierta ? 'sala--abierta' : 'sala--montaje']}>
          <span class="etiqueta">Sala {romanos[i]}</span>
          <h3>{abierta ? <a href={url(sala)}>{INFO[sala].nombre}</a> : INFO[sala].nombre}</h3>
          <span class="sala__tema">{INFO[sala].tema}</span>
          <p class="sala__desc">{INFO[sala].descripcion}</p>
          <span class="sala__cuenta">{abierta ? `${n} ${n === 1 ? 'pieza' : 'piezas'}` : 'En montaje'}</span>
        </li>
      );
    })
  }
</ul>
