---
// Spec 0014 · Una sección del portafolio. En la vista clásica es un bloque de la página;
// en el gabinete 3D, el mismo HTML se vuelve el panel de su mueble (FR-0014-04 y 06).
import type { Seccion } from '../lib/secciones';
import { infoSeccion, type Idioma } from '../lib/idioma';

interface Props {
  id: Seccion;
  numero: number;
  cuenta?: string;
  idioma?: Idioma;
}
const { id, numero, cuenta, idioma = 'es' } = Astro.props;
const info = infoSeccion(id, idioma);
---

<section class="sp seccion contenedor" id={id} data-seccion={id} aria-labelledby={`t-${id}`}>
  <div class="sp__cabeza seccion__cabeza">
    <p class="etiqueta">{String(numero).padStart(2, '0')} · {cuenta ?? info.corto}</p>
    <h2 id={`t-${id}`} tabindex="-1">{info.nombre}</h2>
    <p>{info.descripcion}</p>
  </div>
  {/* El panel se cierra solo en el gabinete 3D, que existe en español (spec 0009). */}
  {idioma === 'es' && <button type="button" class="sp__cerrar" data-cerrar-seccion aria-label={`Cerrar ${info.nombre}`}>×</button>}
  <slot />
</section>
